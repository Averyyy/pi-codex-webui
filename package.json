{
  "name": "pi-web-codex",
  "version": "0.1.2",
  "description": "A local Web Host for Pi coding-agent workflows.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "web-ui",
    "webui",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Averyyy/pi-codex-webui.git"
  },
  "homepage": "https://github.com/Averyyy/pi-codex-webui",
  "bugs": {
    "url": "https://github.com/Averyyy/pi-codex-webui/issues"
  },
  "bin": {
    "pi-web-codex": "./bin/pi-web-codex.mjs"
  },
  "files": [
    "bin",
    "dist",
    "extensions",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/Averyyy/pi-codex-webui/main/reference/image-9.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "build": "turbo build && node scripts/assemble-dist.mjs",
    "dev": "turbo dev --concurrency=32 --filter=web --filter=@workspace/worker-pi --filter=@workspace/worker-pi-client --filter=@pi-web-codex/extension-sdk --filter=pi-codex-conversion-webui --filter=pi-goal-webui --filter=pi-web-access-webui --filter=pi-prompt-template-model-webui --filter=pi-intercom-webui --filter=pi-dynamic-workflows-webui --filter=pi-ask-user-webui --filter=rpiv-ask-user-question-webui --filter=rpiv-todo-webui",
    "lint": "turbo lint",
    "test": "tsx --tsconfig apps/web/tsconfig.json --conditions=react-server --test apps/web/lib/*.test.ts packages/extension-sdk/src/*.test.ts packages/worker-common/src/*.test.ts webui-extensions/builtin/*/src/*.test.ts",
    "release:verify": "pnpm build && node scripts/verify-release.mjs",
    "format": "turbo format && prettier --write \"bin/**/*.mjs\" \"scripts/**/*.mjs\"",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.19 <23 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
