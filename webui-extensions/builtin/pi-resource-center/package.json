{
  "name": "pi-resource-center-webui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-web-codex/extension-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "piWebCodex": {
    "apiVersion": 1,
    "host": {
      "version": ">=0.1.0 <1.0.0",
      "protocolVersion": 1
    },
    "extensions": [
      {
        "id": "pi-resource-center",
        "name": "Resource Center Web UI",
        "target": {
          "packageName": "pi-resource-center",
          "extensionPath": "**/extensions/resource-center/index.ts",
          "version": ">=0.3.0 <0.4.0",
          "testedVersions": ["0.3.0"],
          "compatibility": {
            "mode": "probe",
            "onUntestedVersion": "allow-if-probe-passes"
          }
        },
        "runtimes": ["pi", "pi-client"],
        "worker": "./dist/worker.mjs",
        "client": "./dist/client.mjs",
        "contributes": {
          "commandAdapters": [
            {
              "command": "resource",
              "handler": "resource-center.open"
            }
          ]
        }
      }
    ]
  }
}
