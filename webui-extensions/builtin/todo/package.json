{
  "name": "rpiv-todo-webui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\" \"tsup.config.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-web-codex/extension-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "piWebCodex": {
    "apiVersion": 1,
    "host": {
      "version": ">=0.1.0 <1.0.0",
      "protocolVersion": 1
    },
    "extensions": [
      {
        "id": "rpiv-todo",
        "name": "RPIV Todo UI",
        "target": {
          "packageName": "@juicesharp/rpiv-todo",
          "extensionPath": "**/index.ts",
          "version": ">=2.7.1 <2.16.0",
          "testedVersions": [
            "2.7.1",
            "2.9.0",
            "2.10.0",
            "2.10.1",
            "2.11.0",
            "2.12.0"
          ],
          "compatibility": {
            "mode": "probe",
            "onUntestedVersion": "allow-if-probe-passes"
          }
        },
        "runtimes": [
          "pi",
          "pi-client"
        ],
        "worker": "./dist/worker.mjs",
        "client": "./dist/client.mjs",
        "contributes": {
          "commandAdapters": [
            {
              "command": "todos",
              "handler": "rpiv-todo.open"
            }
          ]
        }
      }
    ]
  }
}
