{
  "name": "pi-prompt-template-model-webui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\" \"tsup.config.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-web-codex/extension-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "piWebCodex": {
    "apiVersion": 1,
    "host": {
      "version": ">=0.1.0 <1.0.0",
      "protocolVersion": 1
    },
    "extensions": [
      {
        "id": "prompt-template-model",
        "name": "Prompt Template Model Web UI",
        "target": {
          "packageName": "pi-prompt-template-model",
          "extensionPath": "**/index.ts",
          "version": ">=0.12.1 <0.13.0",
          "testedVersions": [
            "0.12.1",
            "0.12.2",
            "0.12.3"
          ],
          "compatibility": {
            "mode": "probe",
            "onUntestedVersion": "allow-if-probe-passes"
          }
        },
        "runtimes": [
          "pi",
          "pi-client"
        ],
        "worker": "./dist/worker.mjs",
        "client": "./dist/client.mjs",
        "contributes": {
          "rendererAdapters": [
            {
              "kind": "message",
              "name": "skill-loaded",
              "handler": "prompt-template.skill-loaded"
            },
            {
              "kind": "message",
              "name": "prompt-template-subagent",
              "handler": "prompt-template.subagent"
            },
            {
              "kind": "message",
              "name": "prompt-template-deterministic",
              "handler": "prompt-template.deterministic"
            },
            {
              "kind": "message",
              "name": "prompt-template-deterministic-complete",
              "handler": "prompt-template.deterministic-complete"
            },
            {
              "kind": "status",
              "name": "prompt-subagent",
              "handler": "prompt-template.status.subagent"
            },
            {
              "kind": "status",
              "name": "prompt-loop",
              "handler": "prompt-template.status.loop"
            },
            {
              "kind": "status",
              "name": "prompt-chain",
              "handler": "prompt-template.status.chain"
            }
          ]
        }
      }
    ]
  }
}
