{
  "name": "pi-intercom-webui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\" \"tsup.config.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-web-codex/extension-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "piWebCodex": {
    "apiVersion": 1,
    "host": {
      "version": ">=0.1.0 <1.0.0",
      "protocolVersion": 1
    },
    "extensions": [
      {
        "id": "intercom",
        "name": "Intercom UI",
        "target": {
          "packageName": "pi-intercom",
          "extensionPath": "**/index.ts",
          "version": ">=0.12.0 <0.19.0",
          "testedVersions": [
            "0.12.0",
            "0.13.0",
            "0.14.0",
            "0.15.0",
            "0.16.0",
            "0.18.1"
          ],
          "compatibility": {
            "mode": "probe",
            "onUntestedVersion": "allow-if-probe-passes"
          }
        },
        "runtimes": [
          "pi",
          "pi-client"
        ],
        "worker": "./dist/worker.mjs",
        "client": "./dist/client.mjs",
        "contributes": {
          "commandAdapters": [
            {
              "command": "intercom",
              "handler": "intercom.open"
            }
          ]
        }
      }
    ]
  }
}
